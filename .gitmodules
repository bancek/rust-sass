[submodule "dart-sass"]
	path = dart-sass
	url = https://github.com/sass/dart-sass.git
	ignore = dirty
[submodule "sass-spec"]
	path = sass-spec
	url = https://github.com/sass/sass-spec.git
	ignore = dirty
[submodule "bootstrap-main"]
	path = bootstrap-main
	url = https://github.com/twbs/bootstrap.git
	ignore = dirty
[submodule "embedded-host-node"]
	path = embedded-host-node
	url = https://github.com/sass/embedded-host-node.git
	ignore = dirty
[submodule "sass"]
	path = sass
	url = https://github.com/sass/sass.git
	ignore = dirty
[submodule "libsass"]
	path = libsass
	url = https://github.com/sass/libsass.git
	ignore = dirty
[submodule "sassc"]
	path = sassc
	url = https://github.com/sass/sassc.git
	ignore = dirty
[submodule "node-sass"]
	path = node-sass
	url = https://github.com/sass/node-sass.git
	ignore = dirty
